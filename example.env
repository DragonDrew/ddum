# ddum settings, for compose.example.yaml. Copy this to .env next to your compose file,
# then fill in the values and run: chmod 600 .env
#
# Every variable is listed, with its default where it has one. Lines starting with # are
# comments. Leave a variable commented out to use its default.
#
# Never commit .env. It holds tokens and keys.


# ---------------------------------------------------------------------------
# Discord (bot only). Create the application and channel as in the README.
# ---------------------------------------------------------------------------

# Bot token, from the Bot page of the Discord developer portal. Keep it secret.
DISCORD_TOKEN=paste-the-bot-token

# Application ID, from General Information. A number of 17 to 20 digits.
DISCORD_APPLICATION_ID=000000000000000000

# Your server's ID (Developer Mode, right-click the server, Copy ID).
DISCORD_GUILD_ID=000000000000000000

# The private channel ddum posts to. Must be a channel in the server above.
NOTIFICATION_CHANNEL_ID=000000000000000000

# Who can use ddum: your Discord user ID, and any others, comma-separated.
# Everyone else gets "You are not authorized."
AUTHORIZED_DISCORD_IDS=000000000000000000


# ---------------------------------------------------------------------------
# Shared key (bot and every agent). It introduces new agents; each agent then has
# its own key. Generate it with: openssl rand -hex 32
# ---------------------------------------------------------------------------

# At least 32 characters. The bot and every agent must have the same value.
AGENT_SHARED_KEY=paste-the-generated-key


# ---------------------------------------------------------------------------
# This host's agent (agent only). Generate the ID with:
#   docker run --rm ghcr.io/dragondrew/ddum-agent:0.10.0 gen-id
# ---------------------------------------------------------------------------

# A UUID, one per host. Keep it the same after upgrades, or the host registers again.
AGENT_ID=paste-the-gen-id-output

# The name shown in Discord. Rename it later with /host rename.
HOST_DISPLAY_NAME=homelab


# ---------------------------------------------------------------------------
# Where the agent reaches the bot (agent only).
# ---------------------------------------------------------------------------

# On the bot's own host, use the service name. Elsewhere, use the bot host's LAN address.
BOT_URL=http://ddum-bot:8080

# The bot's public key, to pin it from the first contact instead of on first use.
# Optional. The bot's key is shown by /system status.
# BOT_PUBLIC_KEY=


# ---------------------------------------------------------------------------
# Time and logs (bot and agent).
# ---------------------------------------------------------------------------

# The time zone for Schedule's times, and for display. Storage is always UTC.
TZ=UTC

# debug, info, warn or error.
LOG_LEVEL=info


# ---------------------------------------------------------------------------
# Bot behaviour (bot only). The defaults are fine for most setups.
# ---------------------------------------------------------------------------

# How often to check registries. At least 5m.
# REGISTRY_CHECK_INTERVAL=6h

# Parallel requests per registry.
# REGISTRY_CONCURRENCY_PER_HOST=4

# How long an agent holds a command before it can be handed out again, in seconds.
# COMMAND_LEASE_SECONDS=120

# A command not started within this many minutes expires.
# COMMAND_EXPIRY_MINUTES=60

# Hours a stack can be missing before its pending updates are closed.
# STACK_MISSING_GRACE_HOURS=24

# More new stacks than this in one check are posted as a single summary.
# NOTIFY_INDIVIDUAL_LIMIT=5

# Where the bot keeps its database inside the container.
# DATABASE_PATH=/data/ddum.db

# Inside the container. Restrict the published port in the compose file, not here.
# LISTEN_ADDRESS=0.0.0.0
# LISTEN_PORT=8080


# ---------------------------------------------------------------------------
# Registry logins (bot, and any agent that pulls private images).
# ---------------------------------------------------------------------------

# A GitHub classic token with read:packages. Raises ghcr.io and lscr.io rate limits.
# Optional. A wrong or expired token shows as DENIED on those images.
# GHCR_TOKEN=

# Directory containing registry config.json, for other private registries.
# Set it only if you've mounted that directory into the container.
# DOCKER_CONFIG=/config/docker


# ---------------------------------------------------------------------------
# Portainer (agent only, on a host that Portainer manages). Leave empty for plain Compose.
# Set all three, or none.
# ---------------------------------------------------------------------------

# Portainer's address, for example https://192.168.1.20:9443
# PORTAINER_URL=

# An access token from Portainer: My account, Access tokens. Keep it secret.
# PORTAINER_TOKEN=

# This host's environment ID: the number in Portainer's URL when the environment is open.
# PORTAINER_ENDPOINT_ID=

# Accepts any certificate, so the token goes to whoever answers. Prefer PORTAINER_CA_FILE.
# PORTAINER_INSECURE_TLS=false

# A PEM file of certificates to trust, mounted into the agent. The safer way to use a
# self-signed Portainer certificate.
# PORTAINER_CA_FILE=


# ---------------------------------------------------------------------------
# Compose stacks (agent only). Needed only for stacks deployed with plain Compose.
# ---------------------------------------------------------------------------

# Folders the agent may edit, comma-separated. Each must be mounted at the same path inside
# the agent as on the host.
# COMPOSE_ALLOWED_ROOTS=/opt/stacks

# Variables that stacks need from the agent's environment, as STACK_ENV_<NAME>.
# They reach Compose as <NAME>. Add the ones your stacks use, for example:
#   STACK_ENV_HOME=/home/you         (for stacks using ~ or ${HOME})
#   STACK_ENV_PUID=1000              (for stacks using a variable from your shell)
# Put a stack's own values in its own .env file where you can, instead.


# ---------------------------------------------------------------------------
# Agent behaviour (agent only). The defaults are fine for most setups.
# ---------------------------------------------------------------------------

# Seconds between polls of the bot, from 3 to 300.
# POLL_INTERVAL_SECONDS=30

# Seconds between full inventories, at least 30.
# INVENTORY_INTERVAL_SECONDS=300

# Where the agent keeps its key, journal and snapshots, inside the container.
# DATA_DIR=/data

# The Docker socket the agent talks to.
# DOCKER_HOST=unix:///var/run/docker.sock

# Which kinds of stack to find: portainer, compose and docker, comma-separated.
# ENABLED_PROVIDERS=portainer,compose,docker

# Rollback snapshots kept per stack.
# SNAPSHOT_RETENTION_COUNT=3


# ---------------------------------------------------------------------------
# Secrets as files (optional). Each secret also accepts a <NAME>_FILE variant, naming a
# file that holds the value, instead of the value itself. If both are set, the file wins.
# Use these with Docker or Compose secrets:
#   DISCORD_TOKEN_FILE, AGENT_SHARED_KEY_FILE, GHCR_TOKEN_FILE, PORTAINER_TOKEN_FILE
# ---------------------------------------------------------------------------
